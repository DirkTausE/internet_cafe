[Unit]
Description=Internetcafe Client Daemon (clientd)
After=network.target

[Service]
Type=simple
# Use a portable installation path (/opt/clientd). Adjust ExecStart if you installed elsewhere.
User=clientd
Group=clientd
EnvironmentFile=-/etc/internetcafe-clientd.conf
ExecStart=/opt/clientd/venv/bin/python /opt/clientd/clientd.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target