[Unit]
Description=Internetcafe Client Daemon (clientd)
After=network.target

[Service]
Type=simple
User=clientd
Group=clientd
# Edit ExecStart path if you installed clientd in a different location
ExecStart=/opt/clientd/venv/bin/python /opt/clientd/clientd.py
Restart=on-failure
RestartSec=5
# Load environment variables (API_KEY, CLIENTD_SECRET) from config file if present
EnvironmentFile=-/etc/internetcafe-clientd.conf

[Install]
WantedBy=multi-user.target